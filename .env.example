# Follow the Shade local development
# Copy this to .env.local and paste real values there.
# The Python backend also reads .env.local in local development.

# Keep true until the FastAPI/LangChain backend is available.
FOLLOW_THE_SHADE_USE_MOCK=true

# Backend data-source mode. Use mock for frontend work; use actual to try server-side
# Google Places, Overpass, and Open-Meteo calls with graceful seed fallbacks.
FOLLOW_THE_SHADE_DATA_MODE=mock
FOLLOW_THE_SHADE_CACHE_TTL_SECONDS=600

# Optional: when the Python backend is running, set this to http://localhost:8000
# and set FOLLOW_THE_SHADE_USE_MOCK=false.
FOLLOW_THE_SHADE_API_BASE_URL=http://127.0.0.1:8000
FOLLOW_THE_SHADE_API_TOKEN=

# LLM / places / weather / speech keys stay server-side.
OPENAI_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
FOURSQUARE_API_KEY=
OUTSCRAPER_API_KEY=
SHADOWMAP_API_KEY=
SHADEMAP_API_KEY=
OVERPASS_URL=https://overpass-api.de/api/interpreter
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
SESSION_TTL_SECONDS=86400
SPLIT_CAFE_SEED_PATH=assets/split_cafe_seed.json
SONIOX_API_KEY=
SONIOX_API_KEY_TTS=
SONIOX_STT_MODEL=stt-rt-v4
SONIOX_TTS_MODEL=tts-rt-v1
SONIOX_TTS_VOICE=

# Public browser token only. Restrict this in the provider dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=
